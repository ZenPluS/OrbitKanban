{
  "name": "orbitkanban-portable",
  "version": "3.4.0",
  "description": "A fully local workspace for tasks, issues, milestones, and Kanban.",
  "main": "src/desktop/main.js",
  "author": "OrbitKanban",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "icon": "electron tools/make-splash.js --icon-only",
    "prestart": "npm run icon",
    "start": "electron .",
    "test": "node --test",
    "check": "node tools/check.js",
    "presmoke": "npm run icon",
    "smoke": "node tools/smoke.js",
    "splash": "electron tools/make-splash.js",
    "predist": "npm run splash",
    "dist": "node tools/build.js"
  },
  "devDependencies": {
    "electron": "43.8.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.orbita.workspace",
    "productName": "OrbitKanban",
    "asar": true,
    "files": [
      "src/**/*",
      "languages/*.json",
      "index.html",
      "styles.css",
      "fonts/**/*",
      "app-logo.svg",
      "app-logo.png"
    ],
    "electronLanguages": [
      "it",
      "en-US",
      "en-GB"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "portable": {
      "unpackDirName": false,
      "artifactName": "OrbitKanban-Portable.exe",
      "splashImage": "build/splash.bmp"
    }
  }
}
